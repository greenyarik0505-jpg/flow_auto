{
  "manifest_version": 3,
  "name": "Flow Auto Helper",
  "version": "1.0",
  "description": "1-клик помощник для копирования токена авторизации Google Flow",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://flow.google.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Скопировать токен Google Flow"
  }
}